module String

  // count, slice, reverse, join, repeat, split and replace are one call into
  // the runtime each. They were interpreted loops over data the runtime already
  // knows the shape of, and they were called from inside other loops, so
  // everything built on them was quadratic. See docs/architecture.md.
  let count = func (str: String) -> Int
    runtime_len(str)
  end

  // No `-> String` on either of these. The body is a subscript, which answers
  // nil on an empty string, and a declared return type would turn that into
  // "declares it returns String but returned Nil" -- an internal contract
  // violation shown to a caller who did nothing wrong. Enum.first and Enum.last
  // have always answered nil the same way and carry no hint for the same reason.
  let first = func (str: String)
    str[0]
  end

  let last = func (str: String)
    str[String.count(str) - 1]
  end

  // A codepoint and a character, in both directions. Aria strings index by
  // rune, so these are codepoints and not bytes: String.code("é") is 233, and
  // String.fromCode(233) is "é".
  //
  // code answers nil for an empty string, the way first and last do, because
  // there is no codepoint to give and an empty string is ordinary data.
  // fromCode raises for a number that is not a codepoint, because that is the
  // caller's arithmetic being wrong rather than an outcome to handle.
  let code = func (str: String)
    runtime_code(str)
  end

  let fromCode = func (code: Int) -> String
    runtime_from_code(code)
  end

  let lower = func (str: String) -> String
    runtime_tolower(str)
  end

  let upper = func (str: String) -> String
    runtime_toupper(str)
  end

  let capitalize = func (str: String) -> String
    var title = str
    for i, v in str
      if i == 0 || str[i - 1] != nil && str[i - 1] == " "
        title[i] = String.upper(v)
      end
    end
    title
  end

  let reverse = func (str: String) -> String
    runtime_reverse(str)
  end

  let slice = func (str: String, start: Int, length: Int) -> String
    if start < 0 || length < 0
      panic("String.slice() expects positive start and length parameters")
    end

    runtime_slice(str, start, length)
  end

  // trim, trimLeft and trimRight strip whitespace unless given a set of
  // characters to strip, and strip every leading or trailing occurrence.
  //
  // They used to require an explicit subset — there was no way to ask for
  // whitespace, which is the overwhelmingly common case — and removed exactly
  // one character per side: trim("  hi  ", " ") was " hi ".
  let whitespace = " \t\n\r"

  let trimLeft = func (str: String, subset: String = String.whitespace) -> String
    let size = String.count(str)
    var start = 0

    for i, v in str
      if !String.contains?(subset, v)
        break
      end
      start = i + 1
    end

    String.slice(str, start, size - start)
  end

  let trimRight = func (str: String, subset: String = String.whitespace) -> String
    let size = String.count(str)
    if size == 0
      return str
    end

    var stop = size
    for i in size - 1..0
      if !String.contains?(subset, str[i])
        break
      end
      stop = i
    end

    String.slice(str, 0, stop)
  end

  let trim = func (str: String, subset: String = String.whitespace) -> String
    String.trimRight(String.trimLeft(str, subset), subset)
  end

  let join = func (array: Array, glue: String) -> String
    runtime_join(array, glue)
  end

  let split  = func (str: String, separator: String) -> Array
    runtime_split(str, separator)
  end

  let starts? = func (str: String, prefix: String) -> Bool
    if String.count(str) < String.count(prefix)
      return false
    end

    if String.slice(str, 0, String.count(prefix)) == prefix
      return true
    end

    false
  end

  let ends? = func (str: String, suffix: String) -> Bool
    if String.count(str) < String.count(suffix)
      return false
    end

    if String.slice(str, String.count(str) - String.count(suffix), String.count(str)) == suffix
      return true
    end

    false
  end

  // The empty-string answer is kept: this scanned the characters of str, so an
  // empty string contains nothing, not even the empty string.
  let contains? = func (str: String, search: String) -> Bool
    if String.count(str) == 0
      return false
    end

    runtime_index_of(str, search, 0) >= 0
  end

  let replace = func (str: String, search: String, replace: String) -> String
    runtime_replace(str, search, replace)
  end

  let match? = func (str: String, regex: String) -> Bool
    runtime_regex_match(str, regex)
  end

  let isEmpty? = func (str: String) -> Bool
    String.count(str) == 0
  end

  let repeat = func (str: String, times: Int) -> String
    if times < 0
      panic("String.repeat() expects a non-negative count")
    end

    runtime_repeat(str, times)
  end

  // padLeft and padRight grow a string to at least size, using pad as the
  // filler. A pad longer than the gap is cut to fit, so the result is exactly
  // size characters when it grows at all.
  let padLeft = func (str: String, size: Int, pad: String = " ") -> String
    if String.count(pad) == 0
      panic("String.padLeft() expects a non-empty pad")
    end

    let gap = size - String.count(str)
    if gap <= 0
      return str
    end

    let filler = String.repeat(pad, gap)
    String.slice(filler, 0, gap) + str
  end

  let padRight = func (str: String, size: Int, pad: String = " ") -> String
    if String.count(pad) == 0
      panic("String.padRight() expects a non-empty pad")
    end

    let gap = size - String.count(str)
    if gap <= 0
      return str
    end

    let filler = String.repeat(pad, gap)
    str + String.slice(filler, 0, gap)
  end

  // indexOf and lastIndexOf answer -1 when the search is absent, so a caller
  // can tell "not found" from "found at 0".
  let indexOf = func (str: String, search: String) -> Int
    if String.count(str) == 0
      return -1
    end

    runtime_index_of(str, search, 0)
  end

  let lastIndexOf = func (str: String, search: String) -> Int
    if String.count(str) == 0
      return -1
    end

    runtime_last_index_of(str, search)
  end

  // A trailing newline ends the last line rather than starting an empty one,
  // which is what makes this usable on a file that ends the way files do.
  let lines = func (str: String) -> Array
    let split = String.split(String.replace(str, "\r\n", "\n"), "\n")
    let size = Enum.size(split)
    if size > 0 && split[size - 1] == ""
      return Enum.take(split, size - 1)
    end
    split
  end

  // words splits on runs of whitespace, so repeated separators do not produce
  // empty entries the way split on a single space would.
  let words = func (str: String) -> Array
    var normalized = str
    for v in String.whitespace
      normalized = String.replace(normalized, v, " ")
    end

    var out = []
    for w in String.split(normalized, " ")
      if w != ""
        out[] = w
      end
    end
    out
  end

end
