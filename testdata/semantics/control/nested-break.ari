// Breaking out of two loops needed a flag variable, which needs a `var`, which
// fights the immutability the README spends a section on. `break N` leaves N
// enclosing loops; plain `break` is `break 1`.
let rows = [[1, 2], [3, 4], [5, 6]]
var found = nil
for row in rows
  for cell in row
    if cell == 4
      found = cell
      break 2
    end
  end
end
println(found)

// One level still stops only the inner loop.
for a in [1, 2]
  for b in [1, 2]
    println("#{a}-#{b}")
    break
  end
end

// It crosses loop kinds, since a loop is a loop.
var n = 0
while true
  for i in 1..10
    n = i
    break 2
  end
end
println(n)
