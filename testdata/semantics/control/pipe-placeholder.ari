// The piped value could only ever land first, so any function whose subject is
// not its first parameter fell out of the pipeline. A `_` among the arguments
// marks the slot instead.
let sub = func (a, b) do a - b end
println(3 |> sub(10, _))
println(3 |> sub(_, 10))

// The argument list is built per evaluation, not by rewriting the tree, so a
// piped call inside a loop does not grow its own arguments.
let three = func (a, b, c) do [a, b, c] end
for i in 1..3
  println(i |> three(_, "b", "c"))
end
