// A module is an ordinary value. It used to live only in the interpreter's
// module registry, so the resolver let a bare module name through as "not a
// binding" and the evaluator then failed with "'Enum' is not defined".
let E = Enum
println(E.size([1, 2, 3]))
println(typeof(Enum))

let apply = func (m, xs) do m.size(xs) end
println(apply(Enum, [1, 2]))

// String is both a conversion builtin and a module. As a value the name has to
// mean one thing, so it means both: the module carries the builtin it shadows.
println(String(42))
println(String.join([1, 2], "-"))
let S = String
println(S(7))
println(S.join(["a", "b"], "+"))
