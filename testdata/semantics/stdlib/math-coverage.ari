println(Math.trunc(-2.9))
println(Math.floor(3))
println(Math.sign(-3.2))
println(Math.sign(0))
println(Math.sign(7))

println(Math.max(3, 7, 1))
println(Math.min(3, 7, 1))
println(Math.max(2))
println(Math.clamp(15, 0, 10))
println(Math.clamp(-1, 0, 10))
println(Math.clamp(5, 0, 10))

println(Math.sqrt(9))
println(Math.cbrt(27))
